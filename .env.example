# ── Django core ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Razorpay (payments) ──────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ── Twilio WhatsApp (owner notifications) ────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_TO=whatsapp:+91xxxxxxxxxx

# ── Redis shared cache (production only) ─────
# Required when DJANGO_ENV=production. Local development keeps the
# zero-config in-memory cache and ignores this variable.
# Placeholder (no credentials): redis://127.0.0.1:6379/0
# Managed providers embed credentials in one URL, e.g.:
#   rediss://default:<password>@<host>:<port>
REDIS_URL=
