# ── Django core ───────────────────────────────
# Environment selection: 'development' or 'production'
DJANGO_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Must be False in production (hardcoded, but shown for clarity)
DEBUG=False

# Comma-separated allowed domains (required in production)
ALLOWED_HOSTS=consolex.in,www.consolex.in

# ── Database (PostgreSQL) ────────────────────
# Preferred: single connection string (Railway / Render / Heroku style).
# If DATABASE_URL is set it takes precedence; the DB_* variables below are
# then ignored. Example: postgres://user:password@host:5432/consolex
DATABASE_URL=postgres://consolex_user:your-strong-database-password@your-postgres-host.rds.amazonaws.com:5432/consolex

# Fallback discrete variables (used only when DATABASE_URL is not set)
DB_NAME=consolex
DB_USER=consolex_user
DB_PASSWORD=your-strong-database-password
DB_HOST=your-postgres-host.rds.amazonaws.com
DB_PORT=5432

# ── Production TLS / HSTS (optional overrides) ──
# Leave the defaults unless your platform needs different behaviour.
# Setting DJANGO_SECURE_PROXY_SSL_HEADER empty disables the proxy header.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO:https
DJANGO_HSTS_SECONDS=31536000
# Keep false unless you intentionally applied at https://hstspreload.org
DJANGO_HSTS_PRELOAD=false

# ── Redis shared cache (production only) ─────
# Required when DJANGO_ENV=production.
# Placeholder (no credentials): redis://127.0.0.1:6379/0
# Managed providers embed credentials in one URL, e.g.:
#   rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379/0

# ── Razorpay (payments) ──────────────────────
# Use rzp_test_* during testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your-live-key-secret-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# ── Twilio WhatsApp (owner notifications) ────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_TO=whatsapp:+91xxxxxxxxxx

# ── Email (SMTP) ────────────────────────────
# Optional: If not configured, email features will not send
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=CONSOLEX <noreply@consolex.in>

# ── CORS / CSRF ──────────────────────────────
# Optional: Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=https://admin.consolex.in,https://app.consolex.in

# Optional: Comma-separated list of CSRF-trusted origins (must be HTTPS)
CSRF_TRUSTED_ORIGINS=https://consolex.in,https://www.consolex.in
